{
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "poor-mans-t-sql-formatter.std.indent": "    ",
    "poor-mans-t-sql-formatter.std.trailingCommas": false,
    "poor-mans-t-sql-formatter.std.uppercaseKeywords": false,
    "poor-mans-t-sql-formatter.expectedLanguages": ["sql", "plaintext", "csharp"],
    "[html]": {
      "editor.defaultFormatter": "vscode.html-language-features",
      "editor.tabSize": 2
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.tabSize": 2
    },
    "[csharp]": {
      "editor.defaultFormatter": "ms-dotnettools.csharp",
      "editor.tabSize": 4
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "dotnet.formatting.organizeImportsOnFormat": true
}